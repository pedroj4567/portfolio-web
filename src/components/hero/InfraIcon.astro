---
/** Infrastructure icons (design doc §4). Decorative: aria-hidden. */
export type InfraName = "db" | "queue" | "cache" | "cloud";

interface Props {
  name: InfraName;
  class?: string;
  /** Variant for the 404: cloud with an error face / queue with an empty slot. */
  broken?: boolean;
}

const { name, class: className, broken = false } = Astro.props;
const ink = "#121212";
---

{name === "db" && (
  <svg
    class={className}
    viewBox="0 0 96 112"
    width="96"
    height="112"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M8 18v76c0 8.8 17.9 16 40 16s40-7.2 40-16V18"
      fill="#D9C4A3"
      stroke={ink}
      stroke-width="1.5"
    />
    <ellipse cx="48" cy="18" rx="40" ry="16" fill="#E6D6BC" stroke={ink} stroke-width="1.5" />
    <path
      d="M8 46c0 8.8 17.9 16 40 16s40-7.2 40-16M8 72c0 8.8 17.9 16 40 16s40-7.2 40-16"
      stroke={ink}
      stroke-width="1.5"
    />
  </svg>
)}
{name === "queue" && (
  <svg
    class={className}
    viewBox="0 0 132 52"
    width="132"
    height="52"
    fill="none"
    aria-hidden="true"
  >
    <rect x="2" y="10" width="28" height="28" rx="6" fill={ink} />
    <rect x="36" y="10" width="28" height="28" rx="6" fill={ink} />
    {broken ? (
      <rect
        x="70"
        y="10"
        width="28"
        height="28"
        rx="6"
        stroke={ink}
        stroke-width="1.5"
        stroke-dasharray="4 4"
      />
    ) : (
      <rect
        x="70"
        y="10"
        width="28"
        height="28"
        rx="6"
        fill="#fff"
        stroke={ink}
        stroke-width="1.5"
      />
    )}
    <path
      d="M106 24h22m-7-7 7 7-7 7"
      stroke={ink}
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "cache" && (
  <svg class={className} viewBox="0 0 96 96" width="96" height="96" fill="none" aria-hidden="true">
    <g stroke={ink} stroke-width="1.5" stroke-linecap="round">
      <path d="M32 6v12M48 6v12M64 6v12M32 78v12M48 78v12M64 78v12M6 32h12M6 48h12M6 64h12M78 32h12M78 48h12M78 64h12" />
    </g>
    <rect
      x="18"
      y="18"
      width="60"
      height="60"
      rx="10"
      fill="#fff"
      stroke={ink}
      stroke-width="1.5"
    />
    <path
      d="M52 28 38 51h11l-4 17 14-24H48l4-16Z"
      fill="#2B59FF"
      stroke={ink}
      stroke-width="1.5"
      stroke-linejoin="round"
    />
  </svg>
)}
{name === "cloud" && (
  <svg
    class={className}
    viewBox="0 0 128 96"
    width="128"
    height="96"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M34 78h62a22 22 0 0 0 2-43.9A30 30 0 0 0 40.6 28 25 25 0 0 0 34 78Z"
      stroke={ink}
      stroke-width="1.5"
      stroke-linejoin="round"
    />
    {broken ? (
      <g stroke={ink} stroke-width="1.5" stroke-linecap="round">
        <path d="M50 44l6 6m0-6-6 6M74 44l6 6m0-6-6 6" />
        <path d="M54 66c6-6 14-6 20 0" />
        <path d="M64 82v4m0 6v2" stroke-dasharray="3 4" />
      </g>
    ) : (
      <path
        d="M64 92V50m-9 9 9-9 9 9"
        stroke={ink}
        stroke-width="1.5"
        stroke-dasharray="4 4"
        stroke-linecap="round"
      />
    )}
  </svg>
)}
