---
import SectionHeader from "@/components/ui/SectionHeader.astro";
import Win from "@/components/ui/Win.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const a = t.about;
const [before, word, after] = a.body;
---

<section id={t.ids.about} class="section relative" aria-labelledby="about-title">
  <!-- Parallax illustration (hidden ≤ 760px) -->
  <svg
    class="par pointer-events-none absolute top-24 right-[6%] max-md:hidden"
    width="140"
    height="120"
    viewBox="0 0 140 120"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M6 22a10 10 0 0 1 10-10h34l12 12h62a10 10 0 0 1 10 10v70a10 10 0 0 1-10 10H16A10 10 0 0 1 6 104V22Z"
      fill="#D9C4A3"
      stroke="#121212"
      stroke-width="1.5"
    ></path>
    <path d="M6 40h128" stroke="#121212" stroke-width="1.5"></path>
  </svg>

  <div class="container-site">
    <SectionHeader id="about-title" eyebrow={a.eyebrow} title={a.title} dot={false} />

    <p class="rv d1 mt-10 max-w-[30ch] text-[clamp(26px,3.6vw,48px)] leading-[1.2] tracking-[-0.02em] text-ink">
      {before}{" "}
      <span class="sel">
        <em class="accent">{word}</em>
      </span>
      {after}
    </p>

    <ul class="mt-16 grid grid-cols-[repeat(auto-fill,minmax(min(100%,280px),1fr))] gap-7">
      <li class="pop">
        <Win title="years.log" bodyClass="p-6">
          <p class="h-display text-[clamp(56px,6vw,84px)] text-ink">
            {a.yearsValue} <em class="accent text-[0.7em]">{a.yearsAccent}</em>
          </p>
          <p class="mt-3 text-muted">{a.yearsText}</p>
        </Win>
      </li>
      <li class="pop">
        <Win title="location.txt" tone="sand" bodyClass="p-6">
          <p class="h-display text-[clamp(54px,calc(6vw-2px),82px)] text-ink">{a.remoteValue}</p>
          <p class="mt-3 text-muted">{a.remoteText}</p>
        </Win>
      </li>
      <li class="pop">
        <Win title="role.md" tone="ink" class="role h-full" bodyClass="p-6 text-white">
          <p class="h-display text-[clamp(36px,3.6vw,52px)] leading-none">{a.roleValue}</p>
          <p class="mt-3 font-mono text-sm opacity-80">{a.roleText}</p>
        </Win>
      </li>
    </ul>
  </div>
</section>

<style>
  /* "Role" card in cobalt (§2b) */
  .role {
    background: linear-gradient(150deg, #4a73ff 0%, #2b59ff 50%, #1f45e0 100%);
  }
  li > :global(.win) {
    height: 100%;
  }
</style>
