---
/**
 * Paper plane that flies over the home with the scroll: it takes off in the hero, passes each
 * section as a "target" and lands on the contact window. It flies BEHIND the content
 * (z-index -1) and eases towards its position, so it glides slowly. Decorative, no library.
 * Hidden at ≤ 760 px (like the parallax illustrations, §8) and with prefers-reduced-motion.
 */
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const keys = ["about", "stack", "career", "projects"] as const;
const targets = keys.map((key, i) => ({
  id: t.ids[key],
  kicker: `${t.flight.target} ${String(i + 1).padStart(2, "0")}`,
  copy: t.flight.goals[key],
}));
---

<div
  class="flight"
  aria-hidden="true"
  data-flight
  data-targets={JSON.stringify(targets)}
  data-contact={t.ids.contact}
>
  <svg class="flight-svg" fill="none">
    <defs>
      <mask id="flight-flown" maskUnits="userSpaceOnUse">
        <path class="flight-reveal" stroke="#fff" stroke-width="8" stroke-linecap="round"></path>
      </mask>
    </defs>
    <path class="flight-route"></path>
    <path class="flight-flown" mask="url(#flight-flown)"></path>
  </svg>

  {targets.map((target) => (
    <span class="flight-mark flight-target" data-target={target.id}>
      <span class="flight-ring">
        <span class="flight-check">✓</span>
      </span>
      <span class="flight-tag">
        <span class="flight-kicker">{target.kicker}</span>
        <span class="flight-copy">{target.copy}</span>
      </span>
    </span>
  ))}

  <span class="flight-mark flight-runway">
    <span class="flight-strip"></span>
    <span class="flight-tag">
      <span class="flight-kicker">{t.flight.landing}</span>
      <span class="flight-copy">{t.flight.landingCopy}</span>
    </span>
  </span>

  <!-- Paper dart seen from above, nose to the right: two wings and the cobalt keel fold. -->
  <span class="flight-plane">
    <svg viewBox="0 0 72 48" width="60" height="40">
      <path
        d="M70 24 4 3 20 24Z"
        fill="#FFFFFF"
        stroke="#121212"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
      <path
        d="M70 24 20 24 4 45Z"
        fill="#E6D6BC"
        stroke="#121212"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
      <path
        d="M70 24 20 24 30 31Z"
        fill="#2B59FF"
        stroke="#121212"
        stroke-width="1.5"
        stroke-linejoin="round"
      ></path>
      <path
        d="M8 10 18 22"
        stroke="#121212"
        stroke-width="1"
        stroke-linecap="round"
        opacity="0.4"
      ></path>
    </svg>
  </span>
</div>

<!-- Real button (outside the aria-hidden layer, which sits behind the content): starts the flight. -->
<button type="button" class="flight-takeoff" data-flight-takeoff>
  <span class="flight-kicker">{t.flight.takeoff}</span>
  <span class="flight-copy">
    {t.flight.takeoffCopy} <span aria-hidden="true">↓</span>
  </span>
</button>

<style>
  /*
   * No z-index on the layer itself (no stacking context): the route and the plane go to -1,
   * BEHIND every component; the target labels sit in the empty gap between sections, above.
   */
  .flight {
    position: absolute;
    inset: 0 0 auto 0;
    height: 0;
    pointer-events: none;
    display: none;
  }
  .flight.is-ready {
    display: block;
  }
  @media (width <= 47.5rem), (prefers-reduced-motion: reduce) {
    .flight.is-ready {
      display: none;
    }
  }

  .flight-svg {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    overflow: visible;
  }
  .flight-route {
    stroke: var(--color-ink);
    stroke-opacity: 0.2;
    stroke-width: 1.5;
    stroke-dasharray: 2 9;
    stroke-linecap: round;
  }
  .flight-flown {
    stroke: var(--color-cobalt);
    stroke-width: 2;
    stroke-dasharray: 10 8;
    stroke-linecap: round;
  }

  .flight-mark {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  /* Label = mono kicker (what kind of stop) + display copy (what the section offers) */
  .flight-tag {
    display: flex;
    flex-direction: column;
    gap: 2px;
    white-space: nowrap;
    padding: 8px 14px 9px;
    border: 1.5px solid var(--color-ink);
    border-radius: 14px;
    box-shadow: 4px 4px 0 var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    transition:
      background 0.45s var(--ease-out-soft),
      color 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft);
  }

  /* Targets: ring centered on the route point, label to its left (the route runs on the right) */
  .flight-target {
    flex-direction: row-reverse;
    translate: calc(-100% + 15px) -50%;
  }
  .flight-ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-surface);
    transition:
      background 0.45s var(--ease-out-soft),
      scale 0.45s var(--ease-reveal);
  }
  .flight-ring::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cobalt);
    transition: opacity 0.3s;
  }
  .flight-check {
    position: absolute;
    color: var(--color-surface);
    font-size: 14px;
    font-weight: 700;
    opacity: 0;
    transition: opacity 0.3s 0.1s;
  }
  .flight-target.is-hit .flight-ring {
    background: var(--color-cobalt);
    scale: 1.12;
  }
  .flight-target.is-hit .flight-ring::before {
    opacity: 0;
  }
  .flight-target.is-hit .flight-check {
    opacity: 1;
  }
  .flight-kicker {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-cobalt);
    transition: color 0.45s var(--ease-out-soft);
  }
  .flight-copy {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }
  .flight-target.is-hit .flight-kicker,
  .flight-runway.is-hit .flight-kicker {
    color: var(--color-cobalt-soft);
  }
  .flight-target.is-hit .flight-tag,
  .flight-runway.is-hit .flight-tag {
    background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-graphite) 100%);
    color: var(--color-paper);
    box-shadow: 4px 4px 0 var(--color-cobalt);
  }

  /* Takeoff CTA under the parked plane. Above the content (z 31), below the navbar (z 40). */
  .flight-takeoff {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 31;
    display: none;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    /* To the right of the parked plane, vertically centered on its line */
    margin: -18px 0 0 40px;
    height: 36px;
    padding: 0 14px;
    border: 1.5px solid var(--color-ink);
    border-radius: 999px;
    background: linear-gradient(135deg, var(--color-ink) 0%, var(--color-graphite) 100%);
    color: var(--color-paper);
    box-shadow: 3px 3px 0 var(--color-cobalt);
    font-family: var(--font-mono);
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
    transition:
      translate 0.45s var(--ease-out-soft),
      box-shadow 0.45s var(--ease-out-soft),
      opacity 0.5s var(--ease-out-soft),
      visibility 0.5s;
  }
  .flight-takeoff.is-ready {
    display: flex;
  }
  .flight-takeoff .flight-kicker {
    color: var(--color-cobalt-soft);
  }
  /* Compact pill: same type size for both parts, on a single line */
  .flight-takeoff .flight-copy {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0;
  }
  .flight-takeoff.is-gone {
    opacity: 0;
    visibility: hidden;
  }
  @media (hover: hover) {
    .flight-takeoff:hover {
      translate: -2px -2px;
      box-shadow: 6px 6px 0 var(--color-cobalt);
    }
  }
  @media (width <= 47.5rem), (prefers-reduced-motion: reduce) {
    .flight-takeoff.is-ready {
      display: none;
    }
  }

  /* Runway on the top edge of the contact window; the label sits after its end, never under the plane */
  .flight-runway {
    align-items: flex-end;
    translate: -150px -100%;
  }
  .flight-strip {
    width: 200px;
    height: 0;
    border-top: 2px dashed var(--color-ink);
  }
  .flight-runway .flight-tag {
    margin-bottom: 6px;
  }
  .flight-runway.is-hit .flight-strip {
    border-top-color: var(--color-cobalt);
  }

  .flight-plane {
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 40px;
    margin: -20px 0 0 -34px;
    z-index: -1;
    filter: drop-shadow(4px 4px 0 rgb(18 18 18 / 0.85));
    will-change: transform;
  }
  .flight-plane svg {
    display: block;
  }
  .flight-plane.is-landed svg {
    animation: touchdown 0.8s var(--ease-reveal);
  }
  @keyframes touchdown {
    40% {
      translate: 0 3px;
      scale: 1.05 0.9;
    }
  }
</style>

<script>
  type Target = { id: string; label: string };
  type Point = { x: number; y: number };
  type Sample = Point & { len: number };

  const SAMPLE_STEP = 6;
  const VIEWPORT_ANCHOR = 0.45;
  /** Share of the remaining distance covered per frame: lower = slower, smoother glide. */
  const GLIDE = 0.045;
  const PLANE_HALF_HEIGHT = 20;

  const root = document.querySelector<HTMLElement>("[data-flight]");
  if (root) initFlight(root);

  function initFlight(root: HTMLElement) {
    const svg = root.querySelector<SVGSVGElement>(".flight-svg")!;
    const route = root.querySelector<SVGPathElement>(".flight-route")!;
    const flown = root.querySelector<SVGPathElement>(".flight-flown")!;
    const reveal = root.querySelector<SVGPathElement>(".flight-reveal")!;
    const plane = root.querySelector<HTMLElement>(".flight-plane")!;
    const takeoff = document.querySelector<HTMLButtonElement>("[data-flight-takeoff]")!;
    const runway = root.querySelector<HTMLElement>(".flight-runway")!;
    const marks = [...root.querySelectorAll<HTMLElement>("[data-target]")];
    const targets: Target[] = JSON.parse(root.dataset.targets!);
    const contact = document.getElementById(root.dataset.contact!);
    const disabled = matchMedia("(width <= 47.5rem), (prefers-reduced-motion: reduce)");

    let samples: Sample[] = [];
    let length = 0;
    let start: Point = { x: 0, y: 0 };
    let land: Point = { x: 0, y: 0 };
    let targetYs: number[] = [];
    let originY = 0;
    let frame = 0;
    let landed = false;
    /** Path length where the plane is drawn now; it chases the scroll target. */
    let shown = -1;

    const place = (el: HTMLElement, p: Point) => {
      el.style.transform = `translate(${p.x}px, ${p.y}px)`;
    };

    // Document coordinates relative to this overlay (robust to any positioned ancestor).
    const docRect = (el: Element, o: Point) => {
      const r = el.getBoundingClientRect();
      return {
        left: r.left + scrollX - o.x,
        top: r.top + scrollY - o.y,
        width: r.width,
        height: r.height,
      };
    };

    function build() {
      if (disabled.matches || !contact) return false;
      const r = root.getBoundingClientRect();
      const o = { x: r.left + scrollX, y: r.top + scrollY };
      originY = o.y;
      const container = contact.querySelector(".container-site") ?? contact;
      const box = docRect(container, o);
      const left = box.left + 24;
      const right = box.left + box.width - 24;
      const width = right - left;

      const hero = document.querySelector(".hero");
      const heroBox = hero ? docRect(hero, o) : { top: 0, height: innerHeight };
      // Parked in the free space at the END of the hero metadata row ("Caracas · +6 años · …"):
      // the plane and the compact button never cover the headline, the lead or the CTAs.
      // If the row has no room left (narrow column), it parks just below the row instead.
      const anchor = document.querySelector<HTMLElement>("[data-flight-start]");
      if (anchor) {
        const row = docRect(anchor, o);
        const last = anchor.lastElementChild as HTMLElement | null;
        const lastRight = last ? docRect(last, o).left + last.offsetWidth : row.left;
        const column = docRect(anchor.parentElement ?? anchor, o);
        const NEEDED = 360; // plane + "despegar · iniciar el recorrido ↓" pill
        start =
          lastRight + NEEDED <= column.left + column.width
            ? { x: lastRight + 56, y: row.top + row.height / 2 }
            : { x: row.left + 34, y: row.top + row.height + 36 };
      } else {
        start = { x: left + width * 0.5, y: heroBox.top + Math.min(innerHeight * 0.4, heroBox.height * 0.42) };
      }

      const points: Point[] = targets.map((target) => {
        const section = document.getElementById(target.id);
        if (!section) return { x: right, y: start.y };
        // Middle of the section's top padding: empty space, so the label covers nothing.
        const a = docRect(section, o);
        const padding = parseFloat(getComputedStyle(section).paddingTop) || 80;
        return { x: right - 20, y: a.top + padding * 0.45 };
      });

      // The plane rests ON the contact window (above its border), not behind it.
      const win = docRect(contact.querySelector(".win") ?? contact, o);
      const runwayY = win.top - 4;
      land = {
        x: win.left + Math.min(win.width * 0.55, win.width - 120),
        y: runwayY - PLANE_HALF_HEIGHT,
      };

      // Monotonic in y (control points between both ends), so y can be searched by bisection.
      let d = `M${start.x} ${start.y}`;
      let prev = start;
      points.forEach((p, i) => {
        const dy = p.y - prev.y;
        const swing = left + width * (i % 2 ? 0.08 : 0.3);
        d += ` C${swing} ${prev.y + dy * 0.35} ${swing} ${p.y - dy * 0.35} ${p.x} ${p.y}`;
        prev = p;
      });
      const dy = land.y - prev.y;
      d += ` C${left + width * 0.12} ${prev.y + dy * 0.45} ${land.x - 340} ${land.y} ${land.x} ${land.y}`;

      route.setAttribute("d", d);
      flown.setAttribute("d", d);
      reveal.setAttribute("d", d);
      length = route.getTotalLength();
      samples = [];
      for (let len = 0; len <= length; len += SAMPLE_STEP) {
        const p = route.getPointAtLength(len);
        samples.push({ x: p.x, y: p.y, len });
      }
      const end = route.getPointAtLength(length);
      samples.push({ x: end.x, y: end.y, len: length });

      svg.setAttribute("width", String(box.left + box.width + 40));
      svg.setAttribute("height", String(runwayY + 80));
      reveal.style.strokeDasharray = `${length} ${length}`;
      targetYs = points.map((p) => p.y);

      place(takeoff, start);
      marks.forEach((mark, i) => place(mark, points[i]));
      place(runway, { x: land.x, y: runwayY });
      return true;
    }

    function indexAtY(y: number): number {
      let lo = 0;
      let hi = samples.length - 1;
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        if (samples[mid].y < y) lo = mid + 1;
        else hi = mid;
      }
      return lo;
    }

    function indexAtLength(len: number): number {
      return Math.min(samples.length - 1, Math.max(0, Math.round(len / SAMPLE_STEP)));
    }

    /** Path length the scroll asks for. */
    function wantedLength(): number {
      const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const progress = Math.min(1, scrollY / maxScroll);
      // Linear term guarantees landing at the bottom; the viewport term keeps it on screen.
      const linear = start.y + progress * (land.y - start.y);
      const follow = scrollY + innerHeight * VIEWPORT_ANCHOR - originY;
      const y = Math.min(land.y, Math.max(start.y, linear, follow));
      return y >= land.y ? length : samples[indexAtY(y)].len;
    }

    function render() {
      frame = 0;
      if (!samples.length) return;
      const wanted = wantedLength();
      if (shown < 0) shown = wanted;
      const gap = wanted - shown;
      shown = Math.abs(gap) < 0.5 ? wanted : shown + gap * GLIDE;

      const i = indexAtLength(shown);
      const s = samples[i];
      const a = samples[Math.max(0, i - 3)];
      const b = samples[Math.min(samples.length - 1, i + 3)];
      const isLanded = shown >= length - 1;
      // Parked on the hero until takeoff, and level once landed.
      const parked = s.len < 2;
      takeoff.classList.toggle("is-gone", shown > 40);
      const angle = isLanded || parked ? 0 : (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
      // Heading left: mirror instead of flying upside down.
      const flip = Math.abs(angle) > 90 ? " scaleY(-1)" : "";

      plane.style.transform = `translate(${s.x}px, ${s.y}px) rotate(${angle}deg)${flip}`;
      reveal.style.strokeDashoffset = String(length - s.len);
      marks.forEach((mark, k) => mark.classList.toggle("is-hit", s.y >= targetYs[k] - 4));
      runway.classList.toggle("is-hit", isLanded);
      if (isLanded !== landed) {
        landed = isLanded;
        plane.classList.toggle("is-landed", landed);
      }
      if (shown !== wanted) schedule();
    }

    function schedule() {
      if (!frame) frame = requestAnimationFrame(render);
    }

    let rebuildTimer = 0;
    const rebuild = () => {
      clearTimeout(rebuildTimer);
      rebuildTimer = window.setTimeout(() => {
        setReady(build());
        shown = Math.min(shown, length);
        schedule();
      }, 120);
    };

    addEventListener("scroll", schedule, { passive: true });
    new ResizeObserver(rebuild).observe(document.body);
    disabled.addEventListener("change", rebuild);
    document.fonts?.ready.then(rebuild);
    const setReady = (ready: boolean) => {
      root.classList.toggle("is-ready", ready);
      takeoff.classList.toggle("is-ready", ready);
    };

    // Takeoff: glide to the first target (native smooth scroll + scroll-margin-top).
    takeoff.addEventListener("click", () => {
      document.getElementById(targets[0].id)?.scrollIntoView({ behavior: "smooth" });
    });

    setReady(build());
    schedule();
  }
</script>
