---
import LangSwitch from "@/components/ui/LangSwitch.astro";
import { contact } from "@/data/career";
import { routes, useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes(lang);

const links = [
  { label: t.nav.home, href: r.home },
  { label: t.nav.about, href: r.section("about") },
  { label: t.nav.stack, href: r.section("stack") },
  { label: t.nav.career, href: r.section("career") },
  { label: t.nav.projects, href: r.section("projects") },
  { label: t.nav.contact, href: r.section("contact") },
];
---

<!-- Full-screen menu ≤ 900px (§6). Closed = inert (not focusable via keyboard). -->
<div id="mobile-menu" class="menu nav:hidden" inert aria-hidden="true" data-menu>
  <div class="container-site flex h-full flex-col py-4">
    <div class="flex items-center gap-3">
      <div class="wbar flex-1 rounded-full! border-[1.5px] border-paper/60 bg-transparent! text-paper">
        <span>— ×</span>
        <span>menu.sh</span>
        <span>•••</span>
      </div>
      <button type="button" class="mclose" aria-label={t.nav.closeMenu} data-menu-close>
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path
            d="M3 3l12 12M15 3L3 15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Menú" class="my-auto">
      <ol class="flex flex-col gap-1">
        {links.map((l, i) => (
          <li class="mitem" style={`--i:${i}`}>
            <a href={l.href} class="mlink" data-menu-link>
              <span class="font-mono text-sm opacity-70">{String(i).padStart(2, "0")}</span>
              <span class="capitalize">{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="mfoot flex flex-wrap items-center gap-3 text-paper">
      <p class="flex h-10 items-center gap-2 rounded-full border-[1.5px] border-paper/60 px-4 font-mono text-xs">
        <span class="status-dot pulse" aria-hidden="true"></span>
        5/5 healthy · {t.nav.available}
      </p>
      <a href={contact.github.href} class="mini" rel="me noopener" target="_blank">
        GitHub ↗
      </a>
      <a href={contact.linkedin.href} class="mini" rel="me noopener" target="_blank">
        LinkedIn ↗
      </a>
      <LangSwitch lang={lang} class="ml-auto" />
    </div>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    color: var(--color-paper);
    background:
      radial-gradient(ellipse 50% 40% at 90% 5%, rgb(255 255 255 / 0.2), transparent 70%),
      radial-gradient(ellipse 50% 40% at 5% 100%, rgb(217 196 163 / 0.35), transparent 70%),
      linear-gradient(160deg, #2b59ff 0%, #1f45e0 60%, #16349f 100%);
    clip-path: circle(0 at calc(100% - 48px) 34px);
    visibility: hidden;
    transition:
      clip-path 0.7s var(--ease-curtain),
      visibility 0s linear 0.7s;
  }
  .menu.open {
    clip-path: circle(150vmax at calc(100% - 48px) 34px);
    visibility: visible;
    transition:
      clip-path 0.7s var(--ease-curtain),
      visibility 0s;
  }

  .mclose {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--color-paper);
    border-radius: 999px;
    color: var(--color-paper);
    transition: background-color 0.4s var(--ease-out-soft);
  }
  .mclose:hover {
    background: var(--color-ink);
  }

  .mlink {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding-block: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(40px, 11vw, 72px);
    letter-spacing: -0.05em;
    line-height: 1;
    transition:
      color 0.45s var(--ease-out-soft),
      padding-left 0.55s var(--ease-out-soft);
  }
  .mlink:hover,
  .mlink:focus-visible {
    color: var(--color-ink);
    padding-left: 12px;
  }

  .mini {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    border-radius: 999px;
  }
  .mini:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .mfoot :global(.lang) {
    border-color: var(--color-ink);
  }

  /* Links rising one after another (70 ms of difference) */
  .mitem,
  .mfoot {
    opacity: 0;
    transform: translateY(48px);
  }
  .mfoot {
    transform: translateY(16px);
  }
  .open .mitem {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.35s var(--ease-reveal) calc(0.28s + var(--i) * 0.07s),
      transform 0.5s var(--ease-reveal) calc(0.28s + var(--i) * 0.07s);
  }
  .open .mfoot {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s ease 0.7s,
      transform 0.4s ease 0.7s;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu.open,
    .open .mitem,
    .open .mfoot {
      transition: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closer = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  function setOpen(open: boolean) {
    if (!menu || !opener) return;
    menu.classList.toggle("open", open);
    menu.inert = !open;
    menu.setAttribute("aria-hidden", String(!open));
    opener.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    (open ? closer : opener)?.focus({ preventScroll: true });
  }

  opener?.addEventListener("click", () => setOpen(true));
  closer?.addEventListener("click", () => setOpen(false));
  menu
    ?.querySelectorAll("[data-menu-link]")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.classList.contains("open")) setOpen(false);
  });
  // If the screen grows past 900px with the menu open, close it.
  matchMedia("(width >= 56.25rem)").addEventListener("change", (e) => e.matches && setOpen(false));
</script>
