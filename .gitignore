# ── Build output ──
dist/
.output/

# ── Generated types / caches (Astro writes dev logs here too) ──
.astro/
.cache/
.eslintcache
*.tsbuildinfo

# ── Dependencies ──
node_modules/
.pnpm-store/

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Environment variables and secrets (keep only the example) ──
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
secrets/

# ── Deploy tooling (local state, may hold tokens/site ids) ──
.netlify/
.vercel/

# ── Tests / coverage ──
coverage/
playwright-report/
test-results/

# ── OS ──
.DS_Store
Thumbs.db

# ── Editors (shared VS Code settings stay versioned) ──
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
